VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_API_ANON_KEY=
VITE_IMAGE_API_BASE_URL=
VITE_IMAGE_API_KEY=
# Remotion video-worker (demo MP4 export). Defaults to http://localhost:4000 if unset.
VITE_VIDEO_WORKER_URL=http://localhost:4000
# Player sub-app: comma-separated allowlist of parent origins allowed to embed the player
# (inbound + outbound postMessage). Must stay in sync with frame-ancestors in vercel.json.
# On the player Vercel project, set this to include https://ai-storybook-editor.vercel.app
VITE_PLAYER_ALLOWED_PARENT_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,https://ai-storybook-editor.vercel.app

# Deployed Player sub-app (embed preview iframe)
VITE_PLAYER_BASE_URL=https://ai-storybook-player.vercel.app

# Remix Editor sub-app (Vite entry #3). Base URL of the Remix Swap Service gateway
# (editor-session JWT auth + session exchange endpoint — ADR-053). Dev default: http://localhost:8100
VITE_REMIX_SWAP_SERVICE_BASE_URL=http://localhost:8100
# Deeplink back to the Admin App (shown on the needs_admin_app screen).
VITE_ADMIN_APP_URL=

# Self-hosted Storage Service (ADR-054). LEAVE EMPTY ⇒ use Supabase Storage;
# SET ⇒ route all FE upload/delete through the storage service. Build-time (Vite)
# ⇒ changing this requires a rebuild; rollback = rebuild without it.
VITE_STORAGE_SERVICE_URL=
# Public read base URL for /files/{bucket}/{key} (nginx). Defaults to the service
# URL above when empty.
VITE_STORAGE_PUBLIC_BASE_URL=
