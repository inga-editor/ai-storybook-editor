# video-worker env — loaded via `node --env-file-if-exists=.env` (npm start).
# Native Node env-file: KEY=VALUE literal only, no ${} expansion, no shell.
# Copy to `.env` and fill in. Unset vars fall back to the defaults below.

# Express bind port. Server binds 127.0.0.1 (loopback) — expose via nginx reverse proxy.
PORT=4000

# Shared secret protecting POST /render*. Unset/empty → bypass (dev loopback).
# Production: REQUIRED. Generate: `openssl rand -hex 32`. Must match image-api video_worker_token.
VIDEO_WORKER_TOKEN=

# Max bytes fetched for bgm.url (/render-book) — SSRF/OOM cap. Default 20MB.
BGM_MAX_BYTES=20971520

# ── Storage-service cutover (ADR-054, design 06 §6.1) ────────────────────────
# Book-video finals stream PUT to the self-hosted storage-service (served
# publicly by its nginx). Unset STORAGE_SERVICE_URL → legacy local /files
# fallback (dev/demo): relative publicUrl, no storageKey.
# STORAGE_SERVICE_URL: loopback S2S base, e.g. http://127.0.0.1:8200
STORAGE_SERVICE_URL=
# STORAGE_SERVICE_API_KEY: video-worker's key in storage-service STORAGE_API_KEYS.
STORAGE_SERVICE_API_KEY=
# STORAGE_BUCKET: bucket book videos are filed under. Default storybook-assets.
STORAGE_BUCKET=storybook-assets
# MAX_KEEP_MASTERS: LRU cap for the out/qhd master cache (transcode source). Default 3.
MAX_KEEP_MASTERS=3
